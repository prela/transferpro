# Copy to `.env` and fill in local values. Never commit `.env`.

DATABASE_URL=
AUTH_DATABASE_URL=
QUEUE_DATABASE_URL=
# transferpro_platform. Directory reads and renames only. Not the migrator.
PLATFORM_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. Production defaults to info; local and test default to debug.
LOG_LEVEL=

# Mailer. All Resend API keys on the account share one daily quota.
# Production must set MAILER=resend and RESEND_API_KEY.
# Development: leave both unset to log subject and recipient domain only.
# Set both only when you intend to send real mail from this machine.
MAILER=
RESEND_API_KEY=

# Error tracking. Omit locally unless you are verifying Sentry or GlitchTip.
# GlitchTip uses the same DSN format; see docs/ops/error-tracking.md.
SENTRY_DSN=
SENTRY_RELEASE=

# Owner/migrator connection is DATABASE_MIGRATE_URL in gitignored `.env.migrate`.
# It is not an app env field. Copy `.env.migrate.example`. See docs/handoff/19-assign.md.
