# Copy to `.env` and fill in local values. Never commit `.env`.

# `pnpm test:e2e` does not open these databases. It rewrites each URL to
# `transferpro_e2e` on localhost, drops and recreates that database, and
# migrates it. The dev database named here is left as it is.
DATABASE_URL=
AUTH_DATABASE_URL=
QUEUE_DATABASE_URL=
# transferpro_platform. Directory reads and renames only. Not the migrator.
PLATFORM_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. Production defaults to info; local and test default to debug.
LOG_LEVEL=

# Mailer. All Resend API keys on the account share one daily quota.
# Production must set MAILER=resend and RESEND_API_KEY.
# Development: leave both unset to log subject and recipient domain only.
# Set both only when you intend to send real mail from this machine.
# Preview (ADR-0042): set MAILER=resend, RESEND_API_KEY, and MAIL_ALLOWLIST.
# MAIL_ALLOWLIST is a comma-separated list of emails. Only those recipients
# are sent; everyone else is the console line. Production leaves it unset.
# A console-only deployment (ADR-0037): set MAILER=console and
# ALLOW_CONSOLE_MAILER=1. The flag must be exactly 1.
MAILER=
RESEND_API_KEY=
MAIL_ALLOWLIST=
ALLOW_CONSOLE_MAILER=

# Maps. Address suggestions. Default none, so a fresh environment never calls
# the provider. google requires MAPS_API_KEY. One key and one Cloud quota
# per environment. Tests and E2E ignore this and use the fake adapter.
MAPS=
MAPS_API_KEY=

# Error tracking. Omit locally unless you are verifying Sentry or GlitchTip.
# GlitchTip uses the same DSN format; see docs/ops/error-tracking.md.
SENTRY_DSN=
SENTRY_RELEASE=

# Owner/migrator connection is DATABASE_MIGRATE_URL in gitignored `.env.migrate`.
# It is not an app env field. Copy `.env.migrate.example`. See docs/handoff/19-assign.md.

# Backup and restore. Not app env. Do not put these on the app container.
# Names only. Values stay in the scheduled task. See docs/ops/backup-restore.md.
# BACKUP_DATABASE_URL=
# BACKUP_GPG_PASSPHRASE=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=daily
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# RESTORE_DATABASE_URL=
# RESTORE_APP_DATABASE_URL=
# BACKUP_OBJECT_KEY=
