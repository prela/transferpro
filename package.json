{
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "nuxi dev --port 3000",
    "lint": "eslint .",
    "typecheck": "nuxi typecheck && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node --env-file=.env.migrate ./node_modules/drizzle-kit/bin.cjs migrate",
    "tenant:create": "node --import ./scripts/register-ts.mjs --env-file=.env --env-file=.env.migrate ./scripts/tenant-create.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@iconify-json/lucide": "^1.2.139",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@sentry/nuxt": "^11.4.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "h3": "^1.15.11",
    "nuxt": "^4.5.2",
    "pg-boss": "^12.35.1",
    "pino": "^10.3.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "ofetch": "^1.5.1",
    "pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
